package com.flink;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;
import org.apache.flink.api.common.eventtime.WatermarkStrategy;
import org.apache.flink.api.common.state.ValueState;
import org.apache.flink.api.common.state.ValueStateDescriptor;
import org.apache.flink.api.common.typeinfo.Types;
import org.apache.flink.configuration.Configuration;
import org.apache.flink.connector.kafka.source.KafkaSource;
import org.apache.flink.connector.kafka.source.enumerator.initializer.OffsetsInitializer;
import org.apache.flink.connector.kafka.sink.KafkaSink;
import org.apache.flink.connector.kafka.sink.KafkaRecordSerializationSchema;
import org.apache.flink.connector.base.DeliveryGuarantee;
import org.apache.flink.api.common.serialization.SimpleStringSchema;
import org.apache.flink.streaming.api.datastream.DataStream;
import org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;
import org.apache.flink.streaming.api.functions.KeyedProcessFunction;
import org.apache.flink.util.Collector;

import java.time.Duration;
import java.time.Instant;
import java.time.LocalDate;
import java.time.ZoneOffset;
import java.time.ZonedDateTime;
import java.util.Locale;

public class TransactionEnrichmentBackup {

    private static final ObjectMapper MAPPER = new ObjectMapper();

    private static final String KAFKA_SERVER = env("KAFKA_SERVER", "kafka:9092");
    private static final String INPUT_TOPIC = env("KAFKA_INPUT_TOPIC", "transactions_raw");
    private static final String OUTPUT_TOPIC = env("KAFKA_OUTPUT_TOPIC", "transactions_enriched");
    private static final String DLQ_TOPIC = env("KAFKA_DLQ_TOPIC", "fraud_dlq");
    private static final String CONSUMER_GROUP = env("KAFKA_CONSUMER_GROUP", "fraud-enrichment");

    private static final long WATERMARK_DELAY_SECONDS = Long.parseLong(
            env("WATERMARK_DELAY_SECONDS", "5")
    );

    private static final double HIGH_AMOUNT_THRESHOLD = Double.parseDouble(
            env("HIGH_AMOUNT_THRESHOLD", "100000000")
    );

    public static void main(String[] args) throws Exception {
        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();

        configureCheckpoint(env);

        KafkaSource<String> source = KafkaSource.<String>builder()
                .setBootstrapServers(KAFKA_SERVER)
                .setTopics(INPUT_TOPIC)
                .setGroupId(CONSUMER_GROUP)
                .setStartingOffsets(OffsetsInitializer.earliest())
                .setValueOnlyDeserializer(new SimpleStringSchema())
                .build();

        DataStream<String> rawStream = env.fromSource(
                source,
                WatermarkStrategy.noWatermarks(),
                "Kafka - transactions_raw"
        );

        DataStream<RawTransaction> parsedStream = rawStream
                .map(TransactionEnrichment::parseTransaction)
                .name("Parse Transaction");

        DataStream<RawTransaction> validStream = parsedStream
                .filter(transaction -> transaction.valid)
                .name("Validation - Valid Transactions");

        DataStream<String> invalidStream = parsedStream
                .filter(transaction -> !transaction.valid)
                .map(TransactionEnrichment::createDlqMessage)
                .name("Validation - Invalid Transactions");

        DataStream<RawTransaction> eventTimeStream = validStream
                .assignTimestampsAndWatermarks(
                        WatermarkStrategy
                                .<RawTransaction>forBoundedOutOfOrderness(
                                        Duration.ofSeconds(WATERMARK_DELAY_SECONDS)
                                )
                                .withTimestampAssigner(
                                        (transaction, timestamp) -> transaction.eventTimestamp
                                )
                )
                .name("Event Time & Watermark");

        DataStream<String> enrichedStream = eventTimeStream
                .keyBy(transaction -> transaction.customerId)
                .process(new EnrichmentProcessFunction())
                .name("Customer Enrichment & Basic Features");

        KafkaSink<String> enrichedSink = KafkaSink.<String>builder()
                .setBootstrapServers(KAFKA_SERVER)
                .setRecordSerializer(
                        KafkaRecordSerializationSchema.builder()
                                .setTopic(OUTPUT_TOPIC)
                                .setValueSerializationSchema(new SimpleStringSchema())
                                .build()
                )
                .setDeliveryGuarantee(DeliveryGuarantee.AT_LEAST_ONCE)
                .build();

        KafkaSink<String> dlqSink = KafkaSink.<String>builder()
                .setBootstrapServers(KAFKA_SERVER)
                .setRecordSerializer(
                        KafkaRecordSerializationSchema.builder()
                                .setTopic(DLQ_TOPIC)
                                .setValueSerializationSchema(new SimpleStringSchema())
                                .build()
                )
                .setDeliveryGuarantee(DeliveryGuarantee.AT_LEAST_ONCE)
                .build();

        enrichedStream
                .sinkTo(enrichedSink)
                .name("Kafka Sink - transactions_enriched");

        invalidStream
                .sinkTo(dlqSink)
                .name("Kafka Sink - fraud_dlq");

        env.execute("TransactionEnrichment");
    }

    private static void configureCheckpoint(StreamExecutionEnvironment env) {
        boolean enabled = Boolean.parseBoolean(
                env("CHECKPOINT_ENABLED", "true")
        );

        if (!enabled) {
            return;
        }

        long interval = Long.parseLong(
                env("CHECKPOINT_INTERVAL", "30000")
        );

        long timeout = Long.parseLong(
                env("CHECKPOINT_TIMEOUT", "60000")
        );

        long minPause = Long.parseLong(
                env("CHECKPOINT_MIN_PAUSE", "5000")
        );

        int maxConcurrent = Integer.parseInt(
                env("CHECKPOINT_MAX_CONCURRENT", "1")
        );

        env.enableCheckpointing(interval);

        env.getCheckpointConfig().setCheckpointTimeout(timeout);
        env.getCheckpointConfig().setMinPauseBetweenCheckpoints(minPause);
        env.getCheckpointConfig().setMaxConcurrentCheckpoints(maxConcurrent);

        String checkpointPath = env(
                "CHECKPOINT_PATH",
                "file:///opt/flink/checkpoints"
        );

        env.getCheckpointConfig().setCheckpointStorage(checkpointPath);
    }

    private static RawTransaction parseTransaction(String json) {
        RawTransaction transaction = new RawTransaction();
        transaction.rawPayload = json;

        try {
            JsonNode node = MAPPER.readTree(json);

            transaction.transactionId = text(node, "transaction_id");
            transaction.customerId = text(node, "customer_id");
            transaction.accountId = text(node, "account_id");
            transaction.transactionType = text(node, "transaction_type");
            transaction.amount = node.has("amount")
                    ? node.get("amount").asDouble()
                    : 0.0;
            transaction.currency = text(node, "currency");
            transaction.merchantId = text(node, "merchant_id");
            transaction.merchantName = text(node, "merchant_name");
            transaction.merchantCategory = text(node, "merchant_category");
            transaction.paymentMethod = text(node, "payment_method");
            transaction.deviceId = text(node, "device_id");
            transaction.ipAddress = text(node, "ip_address");
            transaction.city = text(node, "city");
            transaction.country = text(node, "country");
            transaction.latitude = node.has("latitude")
                    ? node.get("latitude").asDouble()
                    : 0.0;
            transaction.longitude = node.has("longitude")
                    ? node.get("longitude").asDouble()
                    : 0.0;
            transaction.channel = text(node, "channel");

            String timestamp = text(node, "timestamp");

            if (timestamp == null || timestamp.isBlank()) {
                throw new IllegalArgumentException("timestamp is required");
            }

            transaction.eventTimestamp = Instant.parse(timestamp).toEpochMilli();

            validate(transaction);

            transaction.valid = true;

        } catch (Exception e) {
            transaction.valid = false;
            transaction.errorType = "VALIDATION_ERROR";
            transaction.errorMessage = e.getMessage();
        }

        return transaction;
    }

    private static void validate(RawTransaction transaction) {
        if (isBlank(transaction.transactionId)) {
            throw new IllegalArgumentException("transaction_id must not be null");
        }

        if (isBlank(transaction.customerId)) {
            throw new IllegalArgumentException("customer_id must not be null");
        }

        if (transaction.amount <= 0) {
            throw new IllegalArgumentException(
                    "Transaction amount must be greater than zero"
            );
        }

        if (transaction.eventTimestamp <= 0) {
            throw new IllegalArgumentException("timestamp is invalid");
        }
    }

    private static String createDlqMessage(RawTransaction transaction) {
        try {
            ObjectNode dlq = MAPPER.createObjectNode();

            dlq.put(
                    "dlq_id",
                    "DLQ-" + System.currentTimeMillis()
            );

            dlq.put(
                    "source_topic",
                    INPUT_TOPIC
            );

            dlq.put(
                    "source_partition",
                    -1
            );

            dlq.put(
                    "source_offset",
                    -1L
            );

            dlq.put(
                    "event_key",
                    transaction.customerId == null
                            ? ""
                            : transaction.customerId
            );

            dlq.put(
                    "error_type",
                    transaction.errorType
            );

            dlq.put(
                    "error_message",
                    transaction.errorMessage == null
                            ? "Unknown validation error"
                            : transaction.errorMessage
            );

            dlq.put(
                    "failed_at_stage",
                    "ENRICHMENT"
            );

            dlq.put(
                    "retry_count",
                    0
            );

            dlq.put(
                    "timestamp",
                    Instant.now().toString()
            );

            try {
                dlq.set(
                        "original_payload",
                        MAPPER.readTree(transaction.rawPayload)
                );
            } catch (Exception ignored) {
                dlq.put(
                        "original_payload",
                        transaction.rawPayload
                );
            }

            return MAPPER.writeValueAsString(dlq);

        } catch (Exception e) {
            return "{\"error\":\"Unable to create DLQ message\"}";
        }
    }

    private static class EnrichmentProcessFunction
            extends KeyedProcessFunction<String, RawTransaction, String> {

        private transient ValueState<CustomerState> customerState;

        @Override
        public void open(Configuration parameters) {
            ValueStateDescriptor<CustomerState> descriptor =
                    new ValueStateDescriptor<>(
                            "customer-state",
                            Types.POJO(CustomerState.class)
                    );

            customerState = getRuntimeContext().getState(descriptor);
        }

        @Override
        public void processElement(
                RawTransaction transaction,
                Context context,
                Collector<String> out
        ) throws Exception {

            CustomerState state = customerState.value();

            if (state == null) {
                state = new CustomerState();
            }

            boolean isNewDevice =
                    state.lastDeviceId == null
                            || !state.lastDeviceId.equals(transaction.deviceId);

            boolean isNewLocation =
                    state.lastCity == null
                            || !state.lastCity.equalsIgnoreCase(transaction.city);

            ZonedDateTime eventDateTime =
                    Instant.ofEpochMilli(transaction.eventTimestamp)
                            .atZone(ZoneOffset.UTC);

            int eventHour = eventDateTime.getHour();

            boolean isNightTransaction =
                    eventHour >= 22 || eventHour < 6;

            boolean isForeignTransaction =
                    transaction.country != null
                            && !transaction.country.equalsIgnoreCase("Indonesia");

            boolean isHighAmount =
                    transaction.amount >= HIGH_AMOUNT_THRESHOLD;

            String merchantRiskLevel =
                    determineMerchantRisk(transaction);

            int accountAgeDays =
                    determineAccountAge(transaction.customerId);

            String customerRiskLevel =
                    determineCustomerRisk(accountAgeDays);

            ObjectNode enriched = MAPPER.createObjectNode();

            enriched.put(
                    "transaction_id",
                    transaction.transactionId
            );

            enriched.put(
                    "customer_id",
                    transaction.customerId
            );

            enriched.put(
                    "account_id",
                    transaction.accountId
            );

            enriched.put(
                    "transaction_type",
                    transaction.transactionType
            );

            enriched.put(
                    "amount",
                    transaction.amount
            );

            enriched.put(
                    "currency",
                    transaction.currency
            );

            enriched.put(
                    "merchant_id",
                    transaction.merchantId
            );

            enriched.put(
                    "merchant_name",
                    transaction.merchantName
            );

            enriched.put(
                    "merchant_category",
                    transaction.merchantCategory
            );

            enriched.put(
                    "payment_method",
                    transaction.paymentMethod
            );

            enriched.put(
                    "device_id",
                    transaction.deviceId
            );

            enriched.put(
                    "ip_address",
                    transaction.ipAddress
            );

            enriched.put(
                    "city",
                    transaction.city
            );

            enriched.put(
                    "country",
                    transaction.country
            );

            enriched.put(
                    "latitude",
                    transaction.latitude
            );

            enriched.put(
                    "longitude",
                    transaction.longitude
            );

            enriched.put(
                    "channel",
                    transaction.channel
            );

            enriched.put(
                    "account_age_days",
                    accountAgeDays
            );

            enriched.put(
                    "customer_risk_level",
                    customerRiskLevel
            );

            enriched.put(
                    "merchant_risk_level",
                    merchantRiskLevel
            );

            enriched.put(
                    "is_new_device",
                    isNewDevice
            );

            enriched.put(
                    "is_new_location",
                    isNewLocation
            );

            enriched.put(
                    "is_foreign_transaction",
                    isForeignTransaction
            );

            enriched.put(
                    "is_night_transaction",
                    isNightTransaction
            );

            enriched.put(
                    "is_high_amount",
                    isHighAmount
            );

            enriched.put(
                    "event_date",
                    LocalDate.ofInstant(
                            Instant.ofEpochMilli(
                                    transaction.eventTimestamp
                            ),
                            ZoneOffset.UTC
                    ).toString()
            );

            enriched.put(
                    "event_hour",
                    eventHour
            );

            enriched.put(
                    "timestamp",
                    Instant.ofEpochMilli(
                            transaction.eventTimestamp
                    ).toString()
            );

            enriched.put(
                    "processing_time",
                    Instant.now().toString()
            );

            state.lastDeviceId = transaction.deviceId;
            state.lastCity = transaction.city;
            state.lastTransactionTimestamp = transaction.eventTimestamp;
            state.lastAmount = transaction.amount;

            customerState.update(state);

            out.collect(
                    MAPPER.writeValueAsString(enriched)
            );
        }
    }

    private static String determineMerchantRisk(
            RawTransaction transaction
    ) {
        String category =
                transaction.merchantCategory == null
                        ? ""
                        : transaction.merchantCategory.toUpperCase(
                                Locale.ROOT
                        );

        if (category.contains("GAMBLING")
                || category.contains("CRYPTO")
                || category.contains("HIGH_RISK")) {
            return "HIGH";
        }

        int hash =
                Math.abs(
                        (transaction.merchantId == null
                                ? ""
                                : transaction.merchantId).hashCode()
                );

        if (hash % 10 < 2) {
            return "HIGH";
        }

        if (hash % 10 < 5) {
            return "MEDIUM";
        }

        return "LOW";
    }

    private static int determineAccountAge(
            String customerId
    ) {
        int hash =
                Math.abs(customerId.hashCode());

        return 30 + (hash % 1800);
    }

    private static String determineCustomerRisk(
            int accountAgeDays
    ) {
        if (accountAgeDays < 90) {
            return "HIGH";
        }

        if (accountAgeDays < 365) {
            return "MEDIUM";
        }

        return "LOW";
    }

    private static String text(
            JsonNode node,
            String field
    ) {
        if (!node.has(field)
                || node.get(field).isNull()) {
            return null;
        }

        return node.get(field).asText();
    }

    private static boolean isBlank(String value) {
        return value == null || value.isBlank();
    }

    private static String env(
            String key,
            String defaultValue
    ) {
        String value = System.getenv(key);

        return value == null || value.isBlank()
                ? defaultValue
                : value;
    }

    public static class RawTransaction {
        public String transactionId;
        public String customerId;
        public String accountId;
        public String transactionType;
        public double amount;
        public String currency;
        public String merchantId;
        public String merchantName;
        public String merchantCategory;
        public String paymentMethod;
        public String deviceId;
        public String ipAddress;
        public String city;
        public String country;
        public double latitude;
        public double longitude;
        public long eventTimestamp;
        public String channel;
        public String rawPayload;
        public boolean valid;
        public String errorType;
        public String errorMessage;
    }

    public static class CustomerState {
        public String lastDeviceId;
        public String lastCity;
        public long lastTransactionTimestamp;
        public double lastAmount;

        public CustomerState() {
        }
    }
}